# OpenRouter API key (never commit the real .env)

# Answer model priority chain (primary, then OpenRouter model fallbacks).
# Key is restricted to exactly these three models — mandated order:
# GLM 4.7 Flash → Gemini 2.5 Flash Lite → DeepSeek V4.1 Flash
ANSWER_MODELS=z-ai/glm-4.7-flash,google/gemini-2.5-flash-lite,deepseek/deepseek-v4.1-flash

# Reserved for future rerank pass
FAST_MODEL=google/gemini-2.5-flash-lite

# Server
PORT=3000

# Debug endpoint /debug/* only when true
ENABLE_DEBUG=false
