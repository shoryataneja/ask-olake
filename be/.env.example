# OpenRouter API key (never commit the real .env)
OPENROUTER_API_KEY=

# Model IDs — read from env, never hardcoded
FAST_MODEL=google/gemini-2.5-flash-lite
ANSWER_MODEL=deepseek/deepseek-v4.1-flash
ANSWER_MODEL_BACKUP=z-ai/glm-4.7-flash

# Server
PORT=3000

# Debug endpoint /debug/* only when true
ENABLE_DEBUG=false
